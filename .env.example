# Password for /reception/rsvps (any username). Generate one with: openssl rand -base64 18
RSVP_ADMIN_PASSWORD=""

# Where RSVP responses are saved (one JSON line each). Default: ./data/rsvps.jsonl
# On the server, keep it outside the app folder so redeploys never touch it:
# RSVP_FILE="/srv/wedding-data/rsvps.jsonl"

# Invitation details edited at /reception/admin (date, times, programme, contacts, venue).
# Default: ./data/settings.json. Missing file = the built-in defaults.
# SETTINGS_FILE="/srv/wedding-data/settings.json"
